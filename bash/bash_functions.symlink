#!/bin/bash
#
# Place any bash functions in here and they'll get loaded automatically.
# Remember to update the bash_funcs method with any new func. details and an
# example command showing any args if applicable.
#

# Prints any methods contained in this file, provides an easy go-to reference.
bashfuncs() {
  echo ''
  echo 'Bash Functions'
  echo '--------------'
  echo ''

  echo 'findhere - Find files in local dir with given glob e.g.'
  echo '           findhere "*.log"'
  echo 'search   - Grep recursively for pattern in local dir e.g.'
  echo '           search "My Project"'
  echo 'dir      - Create a dir in the local dir and cd into it e.g.'
  echo '           dir newproject'
  echo 'zipit    - Zip a file in the local dir e.g.'
  echo '           zipit newproject'
  echo 'sshi     - SSH using the identity file ~/.ssh/id_rsa e.g.'
  echo '           sshi user@server.com'
  echo 'refresh  - Performs a `git fetch --all --prune`, checks out sit'
  echo '           (if present) or master and pulls from the remote'
  echo 'loadenv  - Exports an ENV file into the current shell session'
  echo '           Provide a file path or it defaults to "./.env" e.g.'
  echo '           loadenv "../../.my_env"'
  echo 'lports   - List all open ports and their PIDs, use `kill <PID>` to close a port'
  echo 'dbash    - Docker exec bash into running container e.g.'
  echo '           dbash container_name'
  echo 'workon   - CD to ~/projects/<project> with bash completion e.g.'
  echo '           workon myproject'
  echo 'cleanup_unused_db_subnets - Delete unused AWS RDS subnet groups'

  echo ''
}
alias shellfuncs=bashfuncs

findhere() {
  find . -name "$1"
}

search() {
  grep -rni "$1" .
}

dir() {
  mkdir "$1" && cd "$1"
}

zipit() {
  zip -r "$1.zip" "$1"
}

sshi() {
  ssh -i ~/.ssh/id_rsa $1
}

refresh() {
  git fetch --all --prune
  local branch="master"
  if git branch | grep "sit"; then
    branch="sit"
  fi
  git checkout $branch
  git pull
}

loadenv() {
  local env_file=${1:-".env"}
  while read env_var; do
    if [ ! -z $env_var ]; then
      export "$env_var"
    fi
  done <"$env_file"
}

lports() {
  lsof -i -P -n | grep LISTEN
}

dbash() {
    docker exec -t -i $(docker ps | grep $1 | awk '{ print $1 }') bash
}

dopper() {
    docker stop $(docker ps | grep $1 | awk '{ print $1 }')
}

workon() {
  project=$1
  cd ${HOME}/projects/$project
}

_workon_completions()
{
  if [ "${#COMP_WORDS[@]}" != "2" ]; then
    return
  fi

  # keep the suggestions in a local variable
  local suggestions=($(compgen -W "$(ls ${HOME}/projects)" -- "${COMP_WORDS[1]}"))
  COMPREPLY=("${suggestions[@]}")
}

complete -F _workon_completions workon

cleanup_unused_db_subnets() {
  local dbsubnets subnet cluster instances reply

  dbsubnets=$(aws rds describe-db-subnet-groups --query "DBSubnetGroups[].[DBSubnetGroupName]" --output text)

  for subnet in $dbsubnets; do
    cluster=$(aws rds describe-db-clusters --query "DBClusters[?DBSubnetGroup=='${subnet}'][DBClusterIdentifier]" --output text)
    instances=$(aws rds describe-db-instances --query "DBInstances[?DBSubnetGroup.DBSubnetGroupName=='${subnet}'].DBInstanceIdentifier" --output text)

    echo "$subnet    $cluster"
    echo "$subnet    $instances"

    if [ -z "${cluster}${instances}" ]; then
      echo "no cluster or instances found for $subnet"
      read -p "Delete $subnet? (y/n) " -n 1 -r reply
      echo
      if [[ $reply =~ ^[Yy]$ ]]; then
        echo "Deleting $subnet..."
        aws rds delete-db-subnet-group --db-subnet-group-name $subnet
      else
        echo "Skipped $subnet"
      fi
    fi
  done
}

iso2epoch() {
    date -d"${1}" +%s
}

iso2epochms() {
    epoch_seconds=$(iso2epoch $1)
    echo $((epoch_seconds * 1000))
}

# Connect a mongo:3.6 client to a DocumentDB tunnel on localhost.
# Usage: docdb36 <app_name> [local_port]
# Assumes the tunnel is already up (e.g. via `caccl-deploy connect -s docdb`)
# and the CA bundle is at ~/.config/ssl/global-bundle.pem. Honors AWS_PROFILE.
docdb36() {
  local app_name="${1:?usage: docdb36 <app_name> [local_port]}"
  local local_port="${2:-27017}"
  local pem_file="$HOME/.config/ssl/global-bundle.pem"
  local secret_arn password

  if [[ ! -f "$pem_file" ]]; then
    echo "Error: CA bundle not found at $pem_file" >&2
    return 1
  fi

  secret_arn=$(aws cloudformation list-exports \
    --query "Exports[?Name=='CacclDeploy-${app_name}-db-password-secret-arn'].Value" \
    --output text)
  if [[ -z "$secret_arn" || "$secret_arn" == "None" ]]; then
    echo "Error: no password secret export for CacclDeploy-${app_name}" >&2
    return 1
  fi

  password=$(aws secretsmanager get-secret-value \
    --secret-id "$secret_arn" --query 'SecretString' --output text)

  docker run --rm -it --network host \
    -v "$pem_file:/ca.pem:ro" mongo:3.6 \
    mongo --host 127.0.0.1 --port "$local_port" --ssl --sslCAFile /ca.pem \
    -u root -p "$password" \
    --sslAllowInvalidHostnames --sslAllowInvalidCertificates
}
