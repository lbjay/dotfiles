
alias cp='cp -i'
alias mv='mv -i'
alias grep='rg -uu --color=auto'
alias cls='clear'
alias se='screen -e^Ee -S main -DR'
alias s='screen -DR'
alias tm='tmux -u new-session -A -s main'   # tmux (Ghostty/Claude workflow); screen se/s untouched
alias vi='nvim'
alias vim='nvim'
alias ports='lsof -i| grep LISTEN'
#alias mkv='mkvirtualenv -a $(pwd) -p `pyenv which python` $(basename `pwd`)'
alias mkv='pyenv virtualenv $(basename $(pwd)) && echo $(basename $(pwd)) > .python-version && pip install -U pip'
alias rmvirtualenv='pyenv virtualenv-delete $(basename $(pwd)) && rm -f .python-version'
alias workong='workon'

# some more ls aliases
#alias ll='ls -alF'
#alias la='ls -A'
#alias l='ls -lCF'

# Add an "alert" alias for long running commands.  Use like so:
#   sleep 10; alert
alias alert='notify-send --urgency=low -i "$([ $? = 0 ] && echo terminal || echo error)" "$(history|tail -n1|sed -e '\''s/^\s*[0-9]\+\s*//;s/[;&|]\s*alert$//'\'')"'

alias oc-stacks='aws opsworks describe-stacks --query "Stacks[].[Name,StackId]" --output text'

# xrandr i3wm w/ dual monitor on/off
alias xlaptop='xrandr --verbose --output eDP-1 --primary --mode 1920x1080 --pos 320x1440 --rotate normal --output DP-1 --off --output HDMI-1 --off --output DP-2 --off --output HDMI-2 --off'
alias xdual='xrandr --verbose --output eDP-1 --primary --mode 1920x1080 --pos 320x1440 --rotate normal --output DP-1 --off --output HDMI-1 --off --output DP-2 --off --output HDMI-2 --mode 2560x1440 --pos 0x0 --rotate normal'
alias xoffice='bash ~/.screenlayout/office.sh'

# django
alias django-secret-key='python -c "import secrets; print(secrets.token_urlsafe())"'

# awscli v2
alias aws2='docker run --rm -it -v ~/.aws:/root/.aws -e TERM -e AWS_PROFILE=${AWS_PROFILE} amazon/aws-cli'

# aws prod profile
alias aws-prod='aws --profile prod'

# ecr login
alias ecr-login='aws ecr get-login-password --region us-east-1 | docker login --username AWS --password-stdin 542186135646.dkr.ecr.us-east-1.amazonaws.com'

# use zed instead of vscode
alias code='zed'

# fancy `ls` replacement - https://github.com/lsd-rs/lsd
alias ls='lsd'
alias l='lsd -l'
alias ll='lsd -l'
alias la='lsd -a'
alias lla='lsd -la'
alias lt='lsd --tree'

alias ec2-ami="aws ssm get-parameter --name /aws/service/ami-amazon-linux-latest/al2023-ami-kernel-default-x86_64 --query 'Parameter.Value' --output text"
